# Copy to .env (gitignored) and fill in. Never commit .env.
GEMINI_API_KEY=
# Agent model (Gemini OpenAI-compatible endpoint)
GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds between LLM calls (free-tier rate limit)
GEMINI_MIN_INTERVAL=6.5
# Optional overrides
# DAY6_CHROMA_PATH=vectorstore/chroma_day6
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
